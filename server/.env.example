# SAP S/4HANA Gateway & OData Integration Configuration
# Set SAP_INTEGRATION_MODE to "REAL_SAP" when connected to an active SAP Gateway service.
# Set SAP_INTEGRATION_MODE to "DEVELOPMENT_MOCK_MODE" for local development without SAP connection.

SAP_INTEGRATION_MODE=DEVELOPMENT_MOCK_MODE

# SAP System Connection Details
SAP_GATEWAY_HOST=https://your-sap-host.domain.com:8038
# Published OData Service Path
SAP_ODATA_SERVICE_PATH=/sap/opu/odata/sap/ZAI_PROCUREMENT_SRV/
SAP_ODATA_VERSION=V2

# SAP Authentication Credentials (STORE SECURELY ON SERVER - NEVER EXPOSE TO FRONTEND)
SAP_USER=YOUR_SAP_USER
SAP_PASSWORD=YOUR_SAP_PASSWORD

# Optional SAP Client Parameter
SAP_CLIENT=100

# Server Configuration
PORT=4000
